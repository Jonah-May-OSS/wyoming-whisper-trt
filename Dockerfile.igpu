# syntax=docker/dockerfile:1

# ===========================================================================
# The NGC PyTorch iGPU container. This replaces l4t-jetpack:r36.4.0, which
# capped the image at python3.10 and a torch 2.5.0a0+nv24.08 wheel from the
# JetPack 6.1 redist (Aug 2024) — the newest torch NVIDIA publishes on that
# channel, since every JetPack 6 wheel index is cp310-only.
#
# The -igpu framework containers are a different track: 26.02-py3-igpu is
# python3.12 with torch 2.11.0a0, CUDA 12.9.11, cuDNN 9.10.2 and TensorRT
# 10.11.0.33+jp6. The +jp6 build and TORCH_CUDA_ARCH_LIST=8.7+PTX are what
# make it valid on JetPack 6 / Orin; it is not suitable for Xavier (sm_72)
# or Thor. 26.02 is the newest -igpu tag — 26.03 through 26.07 have no -igpu
# variant published — so this trails the x86 image's 26.07 by design.
#
# Unlike the x86 Dockerfile, the venv is NOT built here. It is created by
# run.sh on first container start, on the Jetson itself. That is not an
# oversight: the container's TensorRT bindings dlopen libnvdla_compiler.so,
# which ships with the Jetson host driver and is injected by the NVIDIA
# container runtime. It does not exist on an x86 build host, so anything
# that imports tensorrt fails during the build — including torch2trt's
# setup.py, which imports it at module scope. For the same reason there is
# no build-time import assertion here, unlike the x86 image.
#
# run.sh's first-run setup keys off NVIDIA_EMBEDDED (set below): it strips
# the x86 torch/tensorrt pins from requirements.txt and creates the venv
# with --system_site_packages, so torch and TensorRT come from this
# container rather than pip.
# ===========================================================================
FROM nvcr.io/nvidia/pytorch:26.02-py3-igpu

WORKDIR /usr/src/wyoming-whisper-trt

COPY . /usr/src/wyoming-whisper-trt

# python3-venv and git are needed by run.sh's first-run setup, not by this
# build. ffmpeg is the one runtime package the NGC image lacks, and
# openai-whisper needs it to load audio. libcuda.so, nvidia-smi and the DLA
# compiler libraries are injected by the NVIDIA container runtime.
#
# Make apt resilient to a stalled mirror connection (no timeout => can hang
# the build for hours); retries + a 30s timeout make it fail fast and recover.
RUN printf 'Acquire::Retries "3";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99network-resilience \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3-venv \
        git \
        ffmpeg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Jetson must take run.sh's embedded path. Set it in the image as well as in
# the compose files so pulling the image directly cannot get it wrong.
ENV NVIDIA_EMBEDDED=true \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /
COPY ./run.sh ./

EXPOSE 10300

ENTRYPOINT ["bash", "/run.sh"]
