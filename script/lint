#!/usr/bin/env python3
"""Lint and type-check the repository with ruff and ty, in the venv.

Deliberately the same two tools, over the same paths, as the Ruff and ty
workflows run in CI. This script used to run black, isort and mypy alongside
them, which meant it disagreed with CI about formatting and about types -- and
because no workflow invoked it, nobody found out: it had been failing (34 mypy
errors, two files black wanted to reformat) for as long as anyone can tell.
"""

import subprocess

from _common import PROGRAM_DIR, venv_python

python = venv_python()

subprocess.check_call([python, "-m", "ruff", "check", "."], cwd=PROGRAM_DIR)
subprocess.check_call([python, "-m", "ruff", "format", "--check", "."], cwd=PROGRAM_DIR)
subprocess.check_call([python, "-m", "ty", "check"], cwd=PROGRAM_DIR)
