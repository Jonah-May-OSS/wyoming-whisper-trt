#!/usr/bin/env python3
"""Auto-format the repository with ruff, in the venv.

ruff format is the formatter and ruff's "I" rules are the import sorter, so the
black and isort passes this used to run afterwards were a second formatter and
a second import sorter competing for the same files -- whichever ran last won,
and CI's ruff-format step then disagreed with whatever came out.
"""

import subprocess

from _common import PROGRAM_DIR, venv_python

python = venv_python()

subprocess.check_call([python, "-m", "ruff", "check", "--fix", "."], cwd=PROGRAM_DIR)
subprocess.check_call([python, "-m", "ruff", "format", "."], cwd=PROGRAM_DIR)
